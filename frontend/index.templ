package frontend

import (
	"fmt"
	"github.com/lorypelli/server/frontend/components"
	"io/fs"
)

templ Index(route string, entries []fs.DirEntry) {
	@Layout(fmt.Sprintf("Index of %s", route)) {
		@components.Breadcrumbs(route)
		<ul class="entries">
			if route != "/" {
				@components.ParentEntry(route)
			}
			for _, entry := range entries {
				@components.Entry(route, entry)
			}
			if len(entries) == 0 {
				<li class="empty">This directory is empty</li>
			}
		</ul>
	}
}
