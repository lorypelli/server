{
    "name": "fcy",
    "version": "3.0.0",
    "description": "A fast webserver using golang and fiber",
    "type": "module",
    "engines": {
        "node": "^22.15.0 || >=24.0.0"
    },
    "bin": {
        "fcy": "./dist/index.mjs"
    },
    "scripts": {
        "build": "tsdown",
        "dev": "make generate && go run ./cmd/server",
        "format": "pnpm \"/format:.*/\"",
        "format:prettier": "prettier --write .",
        "format:go": "go fmt ./...",
        "format:templ": "go tool templ fmt .",
        "prepublishOnly": "pnpm build"
    },
    "files": [
        "./dist"
    ],
    "keywords": [
        "server",
        "serve",
        "static",
        "assets",
        "websocket",
        "ws",
        "fast",
        "fiber",
        "go",
        "golang"
    ],
    "author": "LoryPelli",
    "license": "MIT",
    "repository": {
        "url": "https://github.com/lorypelli/server"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "prettier": "^3.5.3",
        "prettier-plugin-organize-imports": "^4.1.0",
        "tsdown": "^0.23.0"
    }
}
